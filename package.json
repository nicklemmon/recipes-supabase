    "@testing-library/user-event": "14.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/ui": "4.1.11",
    "concurrently": "10.0.5",
    "happy-dom": "20.11.10",
    "oxlint": "1.80.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
